    "test:e2e": "playwright test",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/vite": "^4.1.13",
    "lucide-react": "^0.468.0",
